<Window x:Class="SmartformOcxLauncher.ProfileFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Profile File"
        Width="480"
        Height="560"
        MinWidth="360"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="ProfileFileDialog_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Profile files in LY"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <ListBox Grid.Row="1"
                 x:Name="FilesListBox"
                 SelectionChanged="FilesListBox_SelectionChanged" />
    </Grid>
</Window>
