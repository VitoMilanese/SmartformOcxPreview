<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off" internalLogFile="c:\temp\nlog-internal.log">

	<targets>
		<target xsi:type="file" name="AppTarget"
				filename="${basedir}/../logs/App_${date:format=yyyy-MM-dd}.log"  keepFileOpen="false"
				archiveFileName="${basedir}/../logs/old/App_${date:format=yyyy-MM-dd}.log" maxArchiveFiles="14" archiveEvery="Day"
				layout="${longdate} ${uppercase:${level}} ${message}" />
	</targets>

	<rules>
		<logger name="AppLogger" minlevel="Debug" writeTo="AppTarget" />
	</rules>
</nlog>
